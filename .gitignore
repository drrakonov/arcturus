# Dependencies
node_modules/

# Build output
dist/

# Environment variables - NEVER commit secrets
.env

# TypeScript incremental build cache
*.tsbuildinfo

# Engine runtime state - regenerated on each start
engine/snapshot.json

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Local environment variants (keep documented examples)
.env.*
!.env.example

# Keep public documentation in the root README only
/docs/
*.[mM][dD]
!/README.md

# Atomic snapshot and private reset backups
**/snapshot.json.*.tmp
*.reset-*.bak
