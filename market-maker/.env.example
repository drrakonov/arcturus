API_BASE_URL=http://localhost:3000
MARKET=SOL_INR
TOTAL_BIDS=15
TOTAL_ASKS=15
INTERVAL_MS=2000
# How far from mid before an order is considered stale
STALE_SPREAD=2
# Fraction to randomly cancel each tick (0.05 = 5%)
RANDOM_CHURN=0.05
# Repeatable quote decisions for the same initial state; concurrent external orders can change fills.
SIMULATOR_SEED=arcturus-demo
# 0 runs until stopped; positive values allow bounded demo runs.
SIMULATOR_TICKS=0
